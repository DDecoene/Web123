{
  "name": "web123",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build core --target web --out-dir ../src/wasm --out-name web123_core",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path core/Cargo.toml"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
